{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with preferences, biological rhythm, goals and onboarding state",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "nickname": { "type": "string", "maxLength": 80 },
        "email": { "type": "string", "maxLength": 150 },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "age": { "type": "number" },
        "wakeTime": { "type": "string", "maxLength": 10 },
        "sleepTime": { "type": "string", "maxLength": 10 },
        "isStudent": { "type": "boolean" },
        "isWorker": { "type": "boolean" },
        "forgetReason": { "type": "string", "maxLength": 200 },
        "primarySubjects": { "type": "array", "description": "Prioritized subjects from quiz" },
        "sports": { "type": "array", "description": "Sports practiced" },
        "workoutDaysCount": { "type": "string", "maxLength": 10 },
        "waterGoalLiters": { "type": "string", "maxLength": 10 },
        "incomeSources": { "type": "string", "maxLength": 200 },
        "financialGoal": { "type": "string", "maxLength": 50 },
        "activeProjectsText": { "type": "string", "maxLength": 300 },
        "selectedHabits": { "type": "array", "description": "Habits to track" },
        "enabledModules": { "type": "array", "description": "Activated modules in Life OS" },
        "onboardingCompleted": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "name", "onboardingCompleted"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "User specific app configuration and module toggles",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "enabledModules": { "type": "array" },
        "notificationTiming": { "type": "string", "maxLength": 10 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document containing quiz preferences, routine and onboarding status"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": "UserSettings",
      "description": "User preferences and system customization"
    }
  }
}
